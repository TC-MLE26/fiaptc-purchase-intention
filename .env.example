PROJECT_NAME=fiaptc-purchase-intention
PROJECT_DESCRIPTION=API de inferência para previsão de intenção de compra
VERSION=0.1.0
DEBUG=false
DOCS_ENABLED=true

HOST=0.0.0.0
PORT=8075

MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_NAME=purchase-intention-classifier
MODEL_ALIAS=champion
PREDICTION_THRESHOLD=0.5

# Defaults aplicados pela API se não definidos (falha rápida com MLflow fora do ar)
# MLFLOW_HTTP_REQUEST_MAX_RETRIES=1
# MLFLOW_HTTP_REQUEST_TIMEOUT=10
